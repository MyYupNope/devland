{
  "name": "artz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx gh-pages -d dist -r https://github.com/MyYupNope/myyupnope.github.io.git -b master --dest artz --dotfiles --remove '*'",
    "test": "npm run test:build && playwright test",
    "test:build": "vite build",
    "test:quick": "npm run test:build && playwright test --grep-invert @slow",
    "test:full": "npm run test:build && playwright test",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gh-pages": "^6.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.160.0"
  }
}
